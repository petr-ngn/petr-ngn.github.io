{
  "name": "petr-nguyen-portfolio",
  "version": "1.0.0",
  "private": true,
  "homepage": "https://petr-ngn.github.io",
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "framer-motion": "^12.42.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.6.0",
    "react-scripts": "5.0.1",
    "styled-components": "^6.4.1",
    "web-vitals": "^5.2.0"
  },
  "devDependencies": {
    "ajv": "^8.11.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^16.18.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "react-snap": "^1.23.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "nth-check": "^2.1.1",
    "serialize-javascript": "^7.0.5",
    "underscore": "^1.13.7",
    "postcss": "^8.5.10",
    "@tootallnate/once": "^3.0.1",
    "minimist": "^1.2.8",
    "body-parser": "^1.20.5",
    "cookie": "^0.7.2",
    "qs": "^6.15.2",
    "send": "^0.19.0",
    "serve-static": "^1.16.3",
    "path-to-regexp": "0.1.13",
    "node-fetch": "^2.7.0",
    "uuid": "^11.1.1",
    "ws": "^8.21.0",
    "html-minifier": "npm:html-minifier-terser@^5.1.1",
    "express": "^4.22.2"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "postbuild": "node scripts/postbuild.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "reactSnap": {
    "inlineCss": false,
    "minifyHtml": {
      "collapseWhitespace": false,
      "removeComments": false
    },
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox",
      "--disable-dev-shm-usage",
      "--disable-gpu"
    ],
    "skipThirdPartyRequests": true,
    "cacheAjaxRequests": false,
    "fixWebpackChunksIssue": false,
    "waitFor": 3000,
    "removeStyleTags": false,
    "removeScriptTags": false,
    "puppeteerExecutablePath": null,
    "headless": true,
    "crawl": true,
    "include": [
      "/"
    ],
    "puppeteerIgnoreHTTPSErrors": true,
    "puppeteerIgnoreDefaultArgs": false
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
